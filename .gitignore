# --- data & results (never commit large sequencing data) ---------------------
/data/
/resources/
/logs/

# Generated outputs. Four auto-generated reports are kept because the README
# links to them; everything else is reproducible from the workflow.
/results/*
!/results/02_report/
/results/02_report/*
!/results/02_report/qc_scorecard.md
!/results/11_sensitivity/
/results/11_sensitivity/*
!/results/11_sensitivity/SENSITIVITY_REPORT.md
!/results/13_motifless/
/results/13_motifless/*
!/results/13_motifless/MOTIFLESS_REPORT.md
!/results/10_igv/
/results/10_igv/*
!/results/10_igv/README.md

# --- large or generated file types -------------------------------------------
*.bam
*.bam.bai
*.bai
*.fastq.gz
*.fq.gz
*.bw
*.zip
*.log
*backup*

# Shell scripts in the repository root only (personal run wrappers).
# Scripts under workflow/ are part of the pipeline and ARE tracked.
/*.sh

# NOTE: do NOT ignore *.txt globally. workflow/envs/locks/*.lock.txt are the
# resolved conda environment specifications and must be committed.

# --- Snakemake internals -----------------------------------------------------
.snakemake/
*.snakemake.log

# --- conda / env builds ------------------------------------------------------
.conda/
.snakemake-conda/

# --- editor / OS -------------------------------------------------------------
.DS_Store
*.swp
__pycache__/
*.pyc
.Rhistory
.RData
