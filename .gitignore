# --- data & results (never commit large sequencing data) ---------------------
/data/
/resources/
/logs/

# Generated outputs. Four auto-generated reports are kept because the README
# links to them; everything else is reproducible from the workflow.
/results/*
!/results/02_report/
/results/02_report/*
!/results/02_report/qc_scorecard.md
!/results/11_sensitivity/
/results/11_sensitivity/*
!/results/11_sensitivity/SENSITIVITY_REPORT.md
!/results/13_motifless/
/results/13_motifless/*
!/results/13_motifless/MOTIFLESS_REPORT.md
!/results/10_igv/
/results/10_igv/*
!/results/10_igv/README.md

# --- large or generated file types -------------------------------------------
*.bam
*.bam.bai
*.bai
*.fastq.gz
*.fq.gz
*.bw
*.zip
*.log
*.bed
*.bedgraph
*.bigwig
*.wig
*.pdf
*.png
*backup*

# Shell scripts in the repository root only (personal run wrappers).
# Scripts under workflow/ are part of the pipeline and ARE tracked.
/*.sh

# NOTE: do NOT ignore *.txt globally. workflow/envs/locks/*.lock.txt are the
# resolved conda environment specifications and must be committed.

# --- Snakemake internals -----------------------------------------------------
.snakemake/
*.snakemake.log

# --- conda / env builds ------------------------------------------------------
.conda/
.snakemake-conda/

# --- editor / OS -------------------------------------------------------------
.DS_Store
*.swp
__pycache__/
*.pyc
.Rhistory
.RData
*.bak

# Keep the directory structure visible even when contents are ignored.
!data/.gitkeep
!resources/.gitkeep
!results/.gitkeep
!logs/.gitkeep

# Selected figures are committed so the README can show what the workflow
# produces. The rest of results/ remains ignored.
!results/07_figures/
results/07_figures/*
!results/07_figures/A909_fig1_composition_volcano.png
!results/07_figures/A909_fig2_binding_targets.png
!results/07_figures/orthology_fig1_conservation.png
!results/07_figures/orthology_fig2_core_concordance.png
!results/07_figures/enrichment_distribution.png
