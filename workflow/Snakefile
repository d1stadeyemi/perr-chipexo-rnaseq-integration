# =============================================================================
# PerR ChIP-exo — reproducible analysis workflow (Group B Streptococcus)
# Stage 1: unpack -> QC -> report   (peak calling / motif / integration to come)
# =============================================================================
# Usage (from the repo root, with the snakemake env active):
#   snakemake --sdm conda --cores 8                        # local
#   snakemake --workflow-profile profiles/isaac            # HPC (Slurm)
# The only user input is config['input_zip'] in config/config.yaml.
# =============================================================================

from snakemake.utils import min_version

min_version("8.0")


include: "rules/common.smk"      # sample discovery from the zip manifest
include: "rules/setup.smk"       # extraction
include: "rules/qc.smk"          # samtools / fastqc / chipexoqual / deeptools
include: "rules/report.smk"      # multiqc + scorecard
include: "rules/reference.smk"   # genome download + geninfo/seq prep (PEAKS)
include: "rules/peaks.smk"       # ChExMix peak calling (PEAKS)
include: "rules/downsample.smk"  # depth-matched ChExMix control
include: "rules/motif.smk"       # MEME-ChIP / TOMTOM / FIMO + peak classification
include: "rules/motifdb.smk"     # discovered motifs vs curated databases
include: "rules/motifless.smk"   # motif-less peak discovery and reporting
include: "rules/integration.smk" # ChIP-exo x RNA-seq direct regulon
include: "rules/orthology.smk"   # cross-serotype ortholog comparison
include: "rules/pileup.smk"      # orthologous-position signal test
include: "rules/figures.smk"     # regulon figures
include: "rules/igv.smk"         # IGV-ready tracks, sessions and documentation
include: "rules/sensitivity.smk" # parameter sensitivity, parallel tree
include: "rules/concordance.smk" # GEM vs ChExMix event concordance


# ----------------------------------------------------------------------------
# Targets.
#   qc   certifies the delivery: provenance, per-sample metrics, reports
#   all  the complete analysis, every stage in dependency order
# ----------------------------------------------------------------------------
rule qc:
    """Delivery certification only. Stops before peak calling."""
    input:
        expand(os.path.join(QC, "header_check", "{s}.header_check.tsv"),
               s=SAMPLE_IDS),
        expand(os.path.join(QC, "chipexoqual", "{s}", "{s}.metrics.tsv"),
               s=SAMPLE_IDS),
        expand(os.path.join(QC, "deeptools", "{strain}.fingerprint.pdf"),
               strain=STRAINS),
        expand(os.path.join(QC, "deeptools", "{strain}.spearman.pdf"),
               strain=STRAINS),
        expand(os.path.join(QC, "deeptools", "{strain}.fragsize.pdf"),
               strain=STRAINS),
        os.path.join(RESULTS, "02_report", "multiqc_report.html"),
        os.path.join(RESULTS, "02_report", "qc_scorecard.tsv"),
        os.path.join(RESULTS, "02_report", "qc_scorecard.md"),


rule all:
    """Everything. Each entry is a module's own aggregate target, so the
    dependency order is resolved by Snakemake rather than asserted here."""
    input:
        rules.qc.input,
        rules.peaks.input,
        rules.downsample.input,
        rules.motif.input,
        rules.motifdb.input,
        rules.motifless.input,
        rules.integration.input,
        rules.orthology.input,
        rules.figures.input,
        rules.pileup.input,
        rules.igv.input,
        rules.concordance.input,
        rules.sensitivity_cheap.input,


rule stage:
    input:
        all_raw_targets(),
